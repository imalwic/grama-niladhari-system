// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  PS_ADMIN
  GN_OFFICER
  RESIDENT
}

enum RequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  READY_FOR_COLLECTION
}

enum NoticeType {
  GENERAL
  ALERT
  DEVELOPMENT
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model PradeshiyaSabha {
  id        String   @id @default(uuid())
  name      String
  district  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wasamas Wasama[]
  users   User[] // Super admins belong to PS directly
  sharedDocuments DocumentPradeshiyaSabha[]
}

model Wasama {
  id                String          @id @default(uuid())
  name              String
  code              String          @unique
  pradeshiyaSabhaId String
  pradeshiyaSabha   PradeshiyaSabha @relation(fields: [pradeshiyaSabhaId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  officers   User[] // GN Officers assigned to this Wasama
  households Household[]
  notices    Notice[]
  subsidyPrograms SubsidyProgram[]
  events     CommunityEvent[]
}

model User {
  id           String  @id @default(uuid())
  nic          String  @unique
  name         String
  email        String? @unique
  phone        String?
  passwordHash String
  role         Role    @default(RESIDENT)

  // Relations based on role
  pradeshiyaSabhaId String? // For SUPER_ADMIN
  pradeshiyaSabha   PradeshiyaSabha? @relation(fields: [pradeshiyaSabhaId], references: [id])

  wasamaId String? // For GN_OFFICER
  wasama   Wasama? @relation(fields: [wasamaId], references: [id])

  residentId      String?   @unique // For RESIDENT (links to Resident profile)
  residentProfile Resident? @relation(fields: [residentId], references: [id])

  notifications AppNotification[]
  supportTickets SupportTicket[]
  auditLogs      AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Household {
  id          String   @id @default(uuid())
  houseNumber String
  address     String
  wasamaId    String
  wasama      Wasama   @relation(fields: [wasamaId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  residents Resident[]
  subsidyApplications SubsidyApplication[]

  @@unique([houseNumber, wasamaId])
}

model Resident {
  id                 String   @id @default(uuid())
  nic                String?  @unique // Children might not have NIC
  fullName           String
  dateOfBirth        DateTime
  relationshipToHead String
  isHeadOfHousehold  Boolean  @default(false)
  isVerified         Boolean  @default(false) // GN Approval Status
  phone              String?

  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])

  // System link
  userAccount User? // Reverse relation from User table

  // Explicit consent for PDPA
  consentGiven Boolean   @default(false)
  consentDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryTags ResidentCategory[]
  requests     Request[]
  grievances   Grievance[]
  rsvps        EventRSVP[]
}

model Category {
  id          String  @id @default(uuid())
  code        String  @unique // e.g., SC-01, GE-01
  name        String // e.g., School Children, Government Employee
  description String?

  residents ResidentCategory[]
}

// Join table for many-to-many relation
model ResidentCategory {
  residentId String
  categoryId String
  resident   Resident @relation(fields: [residentId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([residentId, categoryId])
}

model Notice {
  id            String     @id @default(uuid())
  title         String
  content       String
  type          NoticeType @default(GENERAL)
  wasamaId      String
  wasama        Wasama     @relation(fields: [wasamaId], references: [id])
  publishedById String // The GN officer who published it
  expiresAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Request {
  id                String        @id @default(uuid())
  requestType       String // e.g., "Income Certificate", "Address Confirmation"
  reason            String?
  supportingDocsUrl String? // URL to uploaded docs
  status            RequestStatus @default(PENDING)

  // PDF Generation data
  certificateUrl String? // URL to the generated PDF
  qrCodeToken    String? @unique // Token to verify the PDF

  residentId   String
  resident     Resident @relation(fields: [residentId], references: [id])
  reviewedById String? // The GN officer who reviewed it
  reviewNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppNotification {
  id      String  @id @default(uuid())
  title   String
  message String
  isRead  Boolean @default(false)
  type    String  @default("INFO") // INFO, SUCCESS, WARNING, ERROR

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String       @id @default(uuid())
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  
  userId    String
  user      User         @relation(fields: [userId], references: [id])

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  details     String?  // JSON string
  performedBy String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [performedBy], references: [id])
}

model Grievance {
  id             String   @id @default(uuid())
  subject        String
  description    String
  status         String   @default("PENDING") // PENDING, INVESTIGATING, RESOLVED
  assignedTo     String   @default("GLOBAL_ADMIN") // GN_OFFICER, GLOBAL_ADMIN
  identityType   String   // NIC, PASSPORT, DRIVING_LICENSE
  identityNumber String
  reportedBy     String
  contactInfo    String?
  
  wasamaId       String?
  residentId     String?
  resident       Resident? @relation(fields: [residentId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SharedDocument {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  createdAt DateTime @default(now())

  pradeshiyaSabhas DocumentPradeshiyaSabha[]
}

model DocumentPradeshiyaSabha {
  documentId        String
  pradeshiyaSabhaId String
  document          SharedDocument  @relation(fields: [documentId], references: [id])
  pradeshiyaSabha   PradeshiyaSabha @relation(fields: [pradeshiyaSabhaId], references: [id])

  @@id([documentId, pradeshiyaSabhaId])
}

model SubsidyProgram {
  id          String   @id @default(uuid())
  name        String
  description String?
  amount      Float?
  isActive    Boolean  @default(true)
  wasamaId    String
  wasama      Wasama   @relation(fields: [wasamaId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications SubsidyApplication[]
}

model SubsidyApplication {
  id           String         @id @default(uuid())
  programId    String
  program      SubsidyProgram @relation(fields: [programId], references: [id])
  householdId  String
  household    Household      @relation(fields: [householdId], references: [id])
  status       String         @default("PENDING") // PENDING, APPROVED, REJECTED
  appliedAt    DateTime       @default(now())
  reviewedAt   DateTime?

  @@unique([programId, householdId])
}

model CommunityEvent {
  id          String   @id @default(uuid())
  title       String
  description String
  eventDate   DateTime
  location    String
  wasamaId    String
  wasama      Wasama   @relation(fields: [wasamaId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rsvps EventRSVP[]
}

model EventRSVP {
  eventId    String
  event      CommunityEvent @relation(fields: [eventId], references: [id])
  residentId String
  resident   Resident       @relation(fields: [residentId], references: [id])
  status     String         @default("GOING") // GOING, MAYBE, DECLINED
  createdAt  DateTime       @default(now())

  @@id([eventId, residentId])
}
